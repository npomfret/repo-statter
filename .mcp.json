{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "typescript-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mizchi/lsmcp", "-p", "typescript"]
    },
    "ts-morph": {
      "command": "npx",
      "args": ["-y", "@sirosuzume/mcp-tsmorph-refactor"]
    },
    "context-provider": {
      "command": "npx",
      "args": ["-y", "code-context-provider-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "gitnexus": {
      "command": "npx",
      "args": ["gitnexus", "mcp"]
    },
    "webstorm": {
      "type": "http",
      "url": "http://127.0.0.1:64542/stream",
      "headers": {
        "IJ_MCP_SERVER_PROJECT_PATH": "${PWD}"
      }
    }
  }
}
